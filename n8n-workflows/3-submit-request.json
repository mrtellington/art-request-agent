    {
      "parameters": {
        "jsCode": "// Asana GID lookups\nconst ASANA_GIDS = {\n  customFields: {\n    request: '1211551541910237',\n    client: '1211551542058961',\n    billable: '1211551542058970',\n    value: '1211551542058988',\n    googleFolder: '1211701715737841',\n    projectNumber: '1210695790941177',\n    region: '1212310605793914'\n  },\n  requestTypes: {\n    \"Creative Design Services\": \"1211551541910239\",\n    \"Mockup\": \"1211551541910241\",\n    \"PPTX\": \"1211551541910242\",\n    \"Proofs\": \"1211551541910243\",\n    \"Sneak Peek\": \"1211551541910244\"\n  },\n  valueRanges: {\n    \"<$50k\": \"1211551542058989\",\n    \"$50k-$250k\": \"1211551542058990\",\n    \">$250k\": \"1211551542058991\"\n  },\n  billable: {\n    \"Yes\": \"1211551542058971\",\n    \"No\": \"1211551542058972\"\n  },\n  regions: {\n    \"US\": \"1212310605793915\",\n    \"CAD\": \"1212310605793916\",\n    \"EU\": \"1212310605793917\",\n    \"UK\": \"1212310605793918\",\n    \"APAC\": \"1212310605793919\"\n  }\n};\n\nconst data = $input.item.json;\nconst webhookData = $('Webhook').item.json;\nconst projectFolder = $('Create Project Folder').item.json;\n\nreturn {\n  taskName: `${webhookData.requestType} | ${webhookData.clientName} | ${webhookData.requestTitle}`,\n  customFields: {\n    [ASANA_GIDS.customFields.request]: ASANA_GIDS.requestTypes[webhookData.requestType],\n    [ASANA_GIDS.customFields.client]: webhookData.clientName,\n    [ASANA_GIDS.customFields.billable]: ASANA_GIDS.billable[webhookData.billable],\n    [ASANA_GIDS.customFields.value]: ASANA_GIDS.valueRanges[webhookData.projectValue],\n    [ASANA_GIDS.customFields.googleFolder]: projectFolder.webViewLink || '',\n    [ASANA_GIDS.customFields.projectNumber]: webhookData.projectNumber || '',\n    [ASANA_GIDS.customFields.region]: ASANA_GIDS.regions[webhookData.region]\n  },\n  taskDescription: data.taskDescription,\n  dueDate: webhookData.dueDate\n};"
      },
