        "jsCode": "// Determine Google Drive folder path\nconst clientName = $input.item.json.clientName;\nconst clientExists = $input.item.json.clientExists;\nconst requestTitle = $input.item.json.requestTitle;\n\n// Determine root folder (A-L vs M-Z)\nconst firstLetter = clientExists \n  ? clientName.charAt(0).toUpperCase() \n  : 'N'; // \"Not Listed\" goes under N (M-Z folder)\n\nconst rootFolderID = (firstLetter >= 'A' && firstLetter <= 'L')\n  ? '0ADaZpFm7TUV5Uk9PVA'  // A-L\n  : '0AJgvSmlJR1-tUk9PVA'; // M-Z\n\nreturn {\n  ...json,\n  rootFolderID,\n  folderClientName: clientExists ? clientName : \"Not Listed\",\n  needsYearFolder: clientExists\n};"
      },
